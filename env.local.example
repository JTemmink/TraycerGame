# Supabase Configuration
# Copy this file to .env.local and fill in your actual values from the Supabase dashboard

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anonymous key (safe for client-side use)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Your Supabase service role key (for admin operations - keep this secret!)
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin email for authorization checks
VITE_ADMIN_EMAIL=admin@example.com